# ==============================================================================
# 1. CORE NAVIGATION (VIM-STYLE ARROWS)
# ==============================================================================
# We let terminal applications handle Ctrl+h/j/k/l natively so they work in zsh/vim.
# For other applications, they act as system arrow keys.

ctrl - h [
    "Ghostty" ~
    "ghostty" ~
    "iTerm" ~
    "iTerm2" ~
    "Terminal" ~
    * : skhd -k "left"
]

ctrl - j [
    "Ghostty" ~
    "ghostty" ~
    "iTerm" ~
    "iTerm2" ~
    "Terminal" ~
    * : skhd -k "down"
]

ctrl - k [
    "Ghostty" ~
    "ghostty" ~
    "iTerm" ~
    "iTerm2" ~
    "Terminal" ~
    * : skhd -k "up"
]

ctrl - l [
    "Ghostty" ~
    "ghostty" ~
    "iTerm" ~
    "iTerm2" ~
    "Terminal" ~
    * : skhd -k "right"
]

# Text selection modifiers
ctrl + shift - h : skhd -k "shift - left"
ctrl + shift - j : skhd -k "shift - down"
ctrl + shift - k : skhd -k "shift - up"
ctrl + shift - l : skhd -k "shift - right"

# ==============================================================================
# 2. WORD JUMPING & LINE JUMPING (GLOBAL SYSTEM WIDE)
# ==============================================================================
# We send raw native macOS movements. 
ctrl + alt - h : skhd -k "alt - left"
ctrl + alt - l : skhd -k "alt - right"
ctrl + alt + shift - h : skhd -k "shift + alt - left"
ctrl + alt + shift - l : skhd -k "shift + alt - right"

ctrl + cmd - h : skhd -k "cmd - left"
ctrl + cmd - l : skhd -k "cmd - right"
ctrl + cmd + shift - h : skhd -k "shift + cmd - left"
ctrl + cmd + shift - l : skhd -k "shift + cmd - right"

# ==============================================================================
# 3. UTILITIES
# ==============================================================================
alt + shift - 1 : skhd -k "shift - 0x32"
alt - 1 : skhd -k "0x32"
